{
  config,
  lib,
  pkgs,
  ...
}: {
  home.sessionVariables.HYPRLAND_CONFIG = "${config.xdg.configHome}/hypr/hyprland.lua";

  # Remove only the known generated legacy stub left by the old parser.
  home.activation.removeHyprlandAutogeneratedStub = lib.hm.dag.entryAfter ["writeBoundary"] ''
    hyprlandConf="${config.xdg.configHome}/hypr/hyprland.conf"
    if [ -f "$hyprlandConf" ] \
      && ${pkgs.gnugrep}/bin/grep -Fqx '# This config is a STUB! This should never be generated.' "$hyprlandConf" \
      && ${pkgs.gnugrep}/bin/grep -Fqx 'autogenerated = 1' "$hyprlandConf"; then
      ${pkgs.coreutils}/bin/rm -- "$hyprlandConf"
    fi
  '';

  home.packages = with pkgs; [
    hyprpaper
    wofi
    brightnessctl
  ];

  services.hyprpaper = {
    enable = false;
    settings = {
      preload = [
        "${config.home.homeDirectory}/Pictures/anime_wallpapers/sfw/default.jpeg"
      ];
      wallpaper = [
        "eDP-1,${config.home.homeDirectory}/Pictures/anime_wallpapers/sfw/default.jpeg"
      ];
    };
  };

  wayland.windowManager.hyprland = {
    enable = true;
    configType = "lua";
    # Share nixos-unstable's compositor, plugin ABI, and graphics dependencies.
    package = pkgs.hyprland;
    portalPackage = pkgs.xdg-desktop-portal-hyprland;

    systemd.variables = ["--all"];

    plugins = [
      pkgs.hyprlandPlugins.hy3
    ];

    settings = {
      config = {
        animations.enabled = true;

        general = {
          layout = "hy3";
          border_size = 0;
          gaps_in = 0;
          gaps_out = 0;
          col = {
            active_border = "rgba(88888888)";
            inactive_border = "rgba(00000088)";
          };
        };

        decoration.shadow.enabled = false;
        plugin.hy3 = {
          tabs = {
            height = 15;
            padding = 5;
            render_text = true;
            colors = {
              active = "rgba(88888888)";
              inactive = "rgba(00000088)";
              urgent = "rgba(ff0000ff)";
            };
          };
          autotile = {
            enable = true;
            trigger_width = 800;
            trigger_height = 500;
          };
        };
      };

      monitor = {
        _args = [
          {
            output = "eDP-1";
            mode = "1920x1080@60";
            position = "0x0";
            scale = 1;
          }
        ];
      };

      curve = [
        {
          _args = [
            "fast"
            (lib.generators.mkLuaInline ''
              { type = "bezier", points = { { 0.05, 0.9 }, { 0.1, 1.05 } } }
            '')
          ];
        }
      ];

      animation = [
        {
          _args = [
            {
              leaf = "windows";
              enabled = true;
              speed = 2;
              bezier = "fast";
            }
          ];
        }
        {
          _args = [
            {
              leaf = "windowsOut";
              enabled = true;
              speed = 2;
              bezier = "fast";
              style = "popin 80%";
            }
          ];
        }
        {
          _args = [
            {
              leaf = "border";
              enabled = true;
              speed = 2;
              bezier = "fast";
            }
          ];
        }
        {
          _args = [
            {
              leaf = "fade";
              enabled = true;
              speed = 2;
              bezier = "fast";
            }
          ];
        }
        {
          _args = [
            {
              leaf = "workspaces";
              enabled = true;
              speed = 2;
              bezier = "fast";
            }
          ];
        }
      ];
    };

    extraConfig = builtins.readFile ./bindings-and-startup.lua;
  };

  xdg.configFile."wofi/style.css".text = builtins.readFile ./wofi.css;
}
